#  The fixture for the bondfix rule set: a slice of moneygraph shaped exactly as its
#  pipeline shapes it, small enough to check by hand.
#
#  Three named graphs, named as moneygraph names them, because the oracle query
#  (oracle.rq) addresses them by those IRIs:
#
#    __trades-bonds__  what bin/trades.sh extracts from trade-confirmation text
#    __current__       what bin/create-current-ng.sh assembles, PLUS the purchase activities
#                      it does not yet copy (see README.md: in the live store this is why
#                      the query matches nothing)
#    __units__         currency codes; neither uomReferenceData.ttl nor currency.ttl gives
#                      a currency a gist:symbol
#
#  Trade-side IRIs follow conversion/trades-bonds.rq: a bond trade has no ticker, so its
#  security is keyed by MD5(date + amounts) and every purchase gets its own security,
#  terms and schedule. The COGECO, ENBRIDGE, RBC and ONTARIO trades are copied from the
#  live store; everything else is invented to the same shape.
#
#  Cases, and what the query must do with each:
#
#    A1  COGECO 2031, bought 2025-03-18     matches: coupon terms, interest days, CAD
#    A2  COGECO 2031, bought again 2025-06-02
#                                           matches: a second first-coupon event, keyed
#                                           by its own date and discriminator
#    B   ONTARIO strip 2028                 matches, but no coupon terms and no interest
#                                           days: only the unconditional facts
#    C   ENBRIDGE 2033                      decoy: activity gross is off by 0.01
#    D   ROYAL BANK 2035                    decoy: holding description omits the issuer
#    E   APPLE 2030, USD                    matches: exercises the USD currency key and the
#                                           symbol normalisation (037833DX5.U -> 037833DX5)

@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix gist:  <https://w3id.org/semanticarts/ns/ontology/gist/> .
@prefix gistd: <https://w3id.org/semanticarts/ns/data/gist/> .
@prefix mg:    <https://w3id.org/moneygraph/ns/ontology/> .
@prefix mgx:   <https://w3id.org/moneygraph/ns/taxonomy/> .
@prefix mg3:   <https://w3id.org/moneygraph/ns/data/> .

# ===========================================================================================
mg3:__units__ {
    gistd:_UnitOfMeasure_Canadian_Dollar a gist:UnitOfMeasure ; gist:symbol "CAD" .
    gistd:_UnitOfMeasure_US_Dollar       a gist:UnitOfMeasure ; gist:symbol "USD" .
}

# ===========================================================================================
mg3:__trades-bonds__ {

    mg3:_InvestmentPortfolio:8 a mg:InvestmentPortfolio ;
        gist:isIdentifiedBy mg3:_ID:InvestmentPortfolio:8 .
    mg3:_ID:InvestmentPortfolio:8 a gist:ID ; gist:uniqueText "8" .

    # Magnitudes are keyed by value, so trades share them.
    mg3:_Magnitude:securityTradeTransactionCommission:cad:0.0 a gist:Magnitude ;
        gist:hasAspect mgx:_Aspect_securityTradeTransactionCommission ;
        gist:hasUnitOfMeasure gistd:_UnitOfMeasure_Canadian_Dollar ;
        gist:numericValue 0.0 .
    mg3:_Magnitude:securityShareCount:5000 a gist:Magnitude ;
        gist:hasAspect mgx:_Aspect_securityShareCount ;
        gist:hasUnitOfMeasure gistd:_UnitOfMeasure_each ;
        gist:numericValue 5000 .
    mg3:_Magnitude:securityShareCount:15000 a gist:Magnitude ;
        gist:hasAspect mgx:_Aspect_securityShareCount ;
        gist:hasUnitOfMeasure gistd:_UnitOfMeasure_each ;
        gist:numericValue 15000 .
    mg3:_Magnitude:securityShareCount:10000 a gist:Magnitude ;
        gist:hasAspect mgx:_Aspect_securityShareCount ;
        gist:hasUnitOfMeasure gistd:_UnitOfMeasure_each ;
        gist:numericValue 10000 .

