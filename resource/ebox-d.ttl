PREFIX gist: <https://ontologies.semanticarts.com/gist/>
PREFIX ebox: <http://www.semanticweb.org/doug/ontologies/ebox#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX : <http://data.ebox.ca/id/>

:_dtl1 a ebox:DataTransferLimit ;
   gist:hasMagnitude :_1month ;
   gist:hasMagnitude :_mag2 ;
   gist:isCategorizedBy ebox:_upstream ;
.

:_dtl2 a ebox:DataTransferLimit ;
   gist:hasMagnitude :_1_month ;
   gist:hasMagnitude :_mag3 ;
   gist:isCategorizedBy ebox:_downstream ;
.

:_1_month a gist:Duration ;
	gist:numericValue 30 ;
	gist:hasUnitOfMeasure gist:_day ;
.

:_mag2 a gist:InformationQuantity ;
	gist:numericValue 2000 ;
	gist:hasUnitOfMeasure gist:_bit ;
.

:_mag3 a gist:InformationQuantity ;
	gist:numericValue 100000000 ;
	gist:hasUnitOfMeasure gist:_bit ;
.