@prefix : <http://www.semanticweb.org/doug/ontologies/ebox#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/doug/ontologies/ebox> .

<http://www.semanticweb.org/doug/ontologies/ebox> rdf:type owl:Ontology ;
                                                   owl:imports <https://ontologies.semanticarts.com/o/gistCore11.1.0> ;
                                                   rdfs:comment "Example ontology for an internet service plan." .

#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/doug/ontologies/ebox#BillingPeriod
:BillingPeriod rdf:type owl:Class ;
               rdfs:subClassOf <https://ontologies.semanticarts.com/gist/Behavior> ;
               rdfs:comment "The length of time over which a periodic payment is applied." .


###  http://www.semanticweb.org/doug/ontologies/ebox#BitRate
:BitRate rdf:type owl:Class ;
         owl:equivalentClass [ owl:intersectionOf ( <https://ontologies.semanticarts.com/gist/RatioMagnitude>
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://ontologies.semanticarts.com/gist/hasUnitOfMeasure> ;
                                                      owl:hasValue :_bps
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
         rdfs:subClassOf <https://ontologies.semanticarts.com/gist/RatioMagnitude> ;
         rdfs:comment "Number of bits of information per unit of time." .


###  http://www.semanticweb.org/doug/ontologies/ebox#DataTransferLimit
:DataTransferLimit rdf:type owl:Class ;
                   rdfs:subClassOf <https://ontologies.semanticarts.com/gist/ContractTerm> ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty <https://ontologies.semanticarts.com/gist/hasMagnitude> ;
                                     owl:someValuesFrom <https://ontologies.semanticarts.com/gist/Duration>
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty <https://ontologies.semanticarts.com/gist/hasMagnitude> ;
                                     owl:someValuesFrom <https://ontologies.semanticarts.com/gist/InformationQuantity>
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty <https://ontologies.semanticarts.com/gist/isCategorizedBy> ;
                                     owl:someValuesFrom :TransmissionDirection
                                   ] ;
                   rdfs:comment "Some number of bits that can be transferred in a given unit of time." .


###  http://www.semanticweb.org/doug/ontologies/ebox#InternetPlanSpec
:InternetPlanSpec rdf:type owl:Class ;
                  rdfs:subClassOf <https://ontologies.semanticarts.com/gist/ServiceSpecification> ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty <https://ontologies.semanticarts.com/gist/hasDirectPart> ;
                                    owl:someValuesFrom :DataTransferLimit
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty <https://ontologies.semanticarts.com/gist/hasDirectPart> ;
                                    owl:someValuesFrom :TransmissionRate
                                  ] ;
                  rdfs:comment "Defines the technical characteristics of an internet service plan for a customer." .


###  http://www.semanticweb.org/doug/ontologies/ebox#PlanPrice
:PlanPrice rdf:type owl:Class ;
           rdfs:subClassOf <https://ontologies.semanticarts.com/gist/ContractTerm> ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty <https://ontologies.semanticarts.com/gist/hasMagnitude> ;
                             owl:someValuesFrom <https://ontologies.semanticarts.com/gist/Duration>
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty <https://ontologies.semanticarts.com/gist/hasMagnitude> ;
                             owl:someValuesFrom <https://ontologies.semanticarts.com/gist/Monetary>
                           ] ;
           rdfs:comment "How much the plan is going to cost." .


###  http://www.semanticweb.org/doug/ontologies/ebox#PriceConditions
:PriceConditions rdf:type owl:Class ;
                 rdfs:subClassOf <https://ontologies.semanticarts.com/gist/ContractTerm> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <https://ontologies.semanticarts.com/gist/isCategorizedBy> ;
                                   owl:someValuesFrom :BillingPeriod
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <https://ontologies.semanticarts.com/gist/endDateTime> ;
                                   owl:someValuesFrom xsd:dateTime
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <https://ontologies.semanticarts.com/gist/startDateTime> ;
                                   owl:someValuesFrom xsd:dateTime
                                 ] ;
                 rdfs:comment "Oy, what's this going to cost me?" .


###  http://www.semanticweb.org/doug/ontologies/ebox#TransmissionDirection
:TransmissionDirection rdf:type owl:Class ;
                       rdfs:subClassOf <https://ontologies.semanticarts.com/gist/Behavior> ;
                       rdfs:comment "Defines direction -- up or down -- for bit transmission based on the customer's perspective." .


###  http://www.semanticweb.org/doug/ontologies/ebox#TransmissionRate
:TransmissionRate rdf:type owl:Class ;
                  rdfs:subClassOf <https://ontologies.semanticarts.com/gist/ContractTerm> ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty <https://ontologies.semanticarts.com/gist/hasMagnitude> ;
                                    owl:someValuesFrom :BitRate
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty <https://ontologies.semanticarts.com/gist/isCategorizedBy> ;
                                    owl:someValuesFrom :TransmissionDirection
                                  ] ;
                  rdfs:comment "Defines the upload or download speed in bit/sec." .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/doug/ontologies/ebox#_annually
:_annually rdf:type owl:NamedIndividual ,
                    :BillingPeriod .


###  http://www.semanticweb.org/doug/ontologies/ebox#_bps
:_bps rdf:type owl:NamedIndividual ,
               <https://ontologies.semanticarts.com/gist/RatioUnit> ;
      <https://ontologies.semanticarts.com/gist/hasDenominator> <https://ontologies.semanticarts.com/gist/_second> ;
      <https://ontologies.semanticarts.com/gist/hasNumerator> <https://ontologies.semanticarts.com/gist/_bit> ;
      rdfs:comment "bits per second" .


###  http://www.semanticweb.org/doug/ontologies/ebox#_daily
:_daily rdf:type owl:NamedIndividual ,
                 :BillingPeriod .


###  http://www.semanticweb.org/doug/ontologies/ebox#_downstream
:_downstream rdf:type owl:NamedIndividual ,
                      :TransmissionDirection ;
             rdfs:comment "Data center to customer" .


###  http://www.semanticweb.org/doug/ontologies/ebox#_monthly
:_monthly rdf:type owl:NamedIndividual ,
                   :BillingPeriod .


###  http://www.semanticweb.org/doug/ontologies/ebox#_upstream
:_upstream rdf:type owl:NamedIndividual ,
                    :TransmissionDirection ;
           rdfs:comment "Customer to data center" .


