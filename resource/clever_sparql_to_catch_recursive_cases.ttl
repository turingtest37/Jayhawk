ex:NoRecursiveShapeReferencesConstraint
  a sh:SPARQLConstraint ;
  sh:severity sh:Violation ;
  sh:message "Recursive constraints are disallowed by this profile: a shape is (directly or indirectly) reachable from itself via shape references (e.g., sh:node, sh:property, sh:not, sh:and/or/xone members, sh:qualifiedValueShape, sh:memberShape, sh:reifierShape, sh:someValue)." ;
  sh:select """
    PREFIX sh:  http://www.w3.org/ns/shacl#
    PREFIX rdf: http://www.w3.org/1999/02/22-rdf-syntax-ns#
    SELECT $this
    WHERE {
       FILTER EXISTS {
         $this (
              sh:node
           | sh:property
           | sh:qualifiedValueShape
           | sh:not
           | sh:memberShape
           | sh:reifierShape
           | sh:someValue
           | (sh:and|sh:or|sh:xone)/(rdf:rest*/rdf:first)
         )+ $this .
       }
    }
  """
.

# UNFINISHED As a pattern
# :_Thing_1 :_Thing_2 :_Thing_1 .

